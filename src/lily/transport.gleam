import gleam/bool
import gleam/dict.{type Dict}
import gleam/dynamic.{type Dynamic}
import gleam/dynamic/decode
import gleam/int
import gleam/json.{type Json}
import gleam/list
import gleam/option.{type Option}
import gleam/pair
import gleam/result
import gleam/string

import lily/internal/codec.{
  type MessagePackValue, type Reflected, ReflectedBool, ReflectedConstructor,
  ReflectedDict, ReflectedFloat, ReflectedInteger, ReflectedList, ReflectedNil,
  ReflectedSet, ReflectedString, ReflectedTuple, ValueArray, ValueBytes,
  ValueInteger, ValueMap, ValueString,
}

// =============================================================================
// PUBLIC TYPES
// =============================================================================

/// What a transport gives the client, a function to send a frame and one to
/// close the connection.
///
/// `send` returns `Error` when the frame didn't go out, letting
/// [`with_offline_queue`](#with_offline_queue) hold it and send it later.
pub type Channel {
  Channel(send: fn(BitArray) -> Result(Nil, Nil), close: fn() -> Nil)
}

/// A way for the client to reach the server. Build one with
/// [`websocket`](#websocket) or [`connector`](#connector) and pass it to
/// [`client.connect`](./client.html#connect).
pub opaque type Connector {
  Connector(
    connect: fn(ConnectorHandler) -> Channel,
    pending: fn() -> List(BitArray),
    queues: Bool,
  )
}

/// The callbacks a transport calls. `received` for each frame from the
/// server, `opened` every time the connection opens (the first time included),
/// and `closed` when it is lost.
pub type ConnectorHandler {
  ConnectorHandler(
    received: fn(BitArray) -> Nil,
    opened: fn() -> Nil,
    closed: fn() -> Nil,
  )
}

/// One constructor of a [`CustomDefinition`](#CustomDefinition), from
/// [`constructor`](#constructor).
pub opaque type ConstructorDefinition {
  ConstructorDefinition(name: String, fields: List(WireType))
}

/// A target in a [`Resync`](#Protocol), with how far the client's copy got.
pub type Cursor {
  /// Nothing the client can vouch for, it wants a `Snapshot`
  Unknown(target: SyncTarget)
  /// The state at `sequence` within `epoch`, from the last `Snapshot` and
  /// what followed it, answered with `Unchanged` while that's still current
  Known(target: SyncTarget, epoch: Int, sequence: Int)
}

/// A custom type's constructors in a [`Schema`](#Schema), from
/// [`custom`](#custom).
pub opaque type CustomDefinition {
  CustomDefinition(
    module: String,
    name: String,
    constructors: List(ConstructorDefinition),
  )
}

/// Severity of a `Diagnostic` from Lily.
pub type DiagnosticLevel {
  /// Something was dropped or refused, continues as usual
  Warning
  /// Lily gave up on something, a topic that kept crashing for example
  Failure
}

/// Wire format the [`automatic`](#automatic) serialiser encodes frames in.
///
/// ```gleam
/// transport.automatic(
///   format: transport.Json,
///   max_decode_depth: 128,
///   modules: [],
/// )
/// ```
pub type Format {
  Json
  MessagePack
  /// JSON when served from `localhost`, `127.0.0.1` or `[::1]`, MessagePack
  /// otherwise.
  ByHost
}

/// A module whose custom types are sent over the wire. Build one with
/// [`module`](#module) or [`module_in`](#module_in) and list it in
/// [`automatic`](#automatic).
pub opaque type Module {
  Module(package: String, path: String)
}

/// The frames a client and server exchange. You only handle them yourself
/// when you write a [`serialiser`](#serialiser) of your own.
///
/// Sequence numbers count separately for each [`SyncTarget`](#SyncTarget),
/// within an epoch the server names in each `Snapshot`, so the pair says
/// which state a client holds.
pub type Protocol(model, message) {
  /// Server, confirming a `SessionMessage` or `TopicMessage` was applied.
  Acknowledge(target: SyncTarget, sequence: Int)

  /// Server, right after a client connects, with its id. A client observer
  /// sees it as `ClientIdAssigned`.
  Connected(client_id: String)

  /// Server, in place of an `Acknowledge` when a `SessionMessage` or
  /// `TopicMessage` for this target wasn't applied, such as one for a topic
  /// the client hasn't joined, one that fails the schema, or one the server
  /// refused under its rate limit or load.
  Dropped(target: SyncTarget)

  /// Server, when a `Subscribe` is refused or an admitted topic is revoked.
  Rejected(topic_id: String, reason: RejectionReason)

  /// Client, after it connects, listing every target it wants a `Snapshot` of,
  /// with the state it holds when it can vouch for it.
  Resync(cursors: List(Cursor))

  /// Client, a message for its own session store.
  SessionMessage(payload: message)

  /// Server, a session update sent by
  /// [`server.dispatch_to`](./server.html#dispatch_to) or
  /// [`server.dispatch_to_all`](./server.html#dispatch_to_all).
  SessionUpdate(sequence: Int, payload: message)

  /// Server, the whole state of a target, in reply to `Resync` or `Subscribe`,
  /// at `sequence` within `epoch`.
  Snapshot(target: SyncTarget, epoch: Int, sequence: Int, state: model)

  /// Client, to join a topic. The server replies with `Snapshot` or
  /// `Rejected`.
  Subscribe(topic_id: String)

  /// Client, a message for a shared topic store.
  TopicMessage(topic_id: String, payload: message)

  /// Server, a topic message from another subscriber.
  TopicUpdate(topic_id: String, sequence: Int, payload: message)

  /// Server, in place of a `Snapshot` when the `Resync` cursor named the state
  /// the target is still in.
  Unchanged(target: SyncTarget)

  /// Client, to leave a topic. Nothing is sent back.
  Unsubscribe(topic_id: String)

  /// Server, on every connect, with a build identifier and the wire protocol
  /// version. See
  /// [`browser.reload_on_new_version`](./browser.html#reload_on_new_version).
  Version(hash: String, protocol: Int)
}

/// How the WebSocket connector waits between reconnection attempts.
///
/// ```gleam
/// transport.websocket_with(
///   url: "ws://localhost:8080/ws",
///   reconnect: transport.DefaultBackoff,
/// )
/// ```
pub type Reconnect {
  /// Exponential backoff with the built-in settings, the same as
  /// `Backoff(1000, 30_000, 0.25, 2.0)`.
  DefaultBackoff

  /// Tuned exponential backoff. `base_milliseconds` is the first delay,
  /// multiplied by `multiplier` after each failed attempt and capped at
  /// `max_milliseconds`.
  ///
  /// `jitter_ratio` randomises each delay by plus or minus that fraction,
  /// keeping clients dropped together from all reconnecting at once.
  ///
  /// ```gleam
  /// transport.websocket_with(
  ///   url: "ws://localhost:8080/ws",
  ///   reconnect: transport.Backoff(
  ///     base_milliseconds: 2000,
  ///     max_milliseconds: 60_000,
  ///     jitter_ratio: 0.25,
  ///     multiplier: 2.0,
  ///   ),
  /// )
  /// ```
  Backoff(
    base_milliseconds: Int,
    max_milliseconds: Int,
    jitter_ratio: Float,
    multiplier: Float,
  )
}

/// Why the server refused or revoked a topic subscription.
pub type RejectionReason {
  /// The topic's `Allow` rule refused the client, or crashed
  AccessDenied
  /// No declaration claims the topic id, or the topic would not start
  NotFound
  /// A subscription, topic id or topic count cap was reached
  OverLimit
}

/// The message types a client may send, checked by the server before it builds
/// a payload. Generate it with `gleam run -m lily/dev schema` and pipe it into
/// [`store.schema`](./store.html#schema).
pub opaque type Schema {
  Schema(
    message: WireType,
    model: WireType,
    types: Dict(#(String, String), Dict(String, List(WireType))),
  )
}

/// Turns [`Protocol`](#Protocol) frames into bytes and back. Build one with
/// [`automatic`](#automatic) or [`serialiser`](#serialiser).
pub opaque type Serialiser(model, message) {
  Automatic(format: Format, max_decode_depth: Int)
  Open(
    encode: fn(Protocol(model, message)) -> BitArray,
    decode: fn(BitArray) -> Result(Protocol(model, message), Nil),
  )
}

/// Which store a frame applies to, the per-connection session store or a named
/// shared topic store.
pub type SyncTarget {
  Session
  Topic(id: String)
}

/// A field's type in a [`Schema`](#Schema).
///
/// `Variable` is the enclosing custom type's parameter by position, and
/// `Anything` skips the check, for opaque and external types.
pub type WireType {
  IntType
  FloatType
  StringType
  BoolType
  NilType
  ListOf(WireType)
  DictOf(key: WireType, value: WireType)
  SetOf(WireType)
  TupleOf(List(WireType))
  Custom(module: String, name: String, parameters: List(WireType))
  Variable(index: Int)
  Anything
}

// =============================================================================
// PUBLIC FUNCTIONS
// =============================================================================

/// Creates a serialiser that encodes any Gleam value, with no codecs to write.
/// Pass it to [`store.sync_with`](./store.html#sync_with).
///
/// `format` picks what this end writes, and it reads either format whatever
/// you pick. `max_decode_depth` caps how deeply a frame may nest, in either
/// format.
///
/// `modules` lists the modules that define the types you send. Constructor
/// names that cross the wire must be unique per arity across them.
///
/// ```gleam
/// transport.automatic(
///   format: transport.MessagePack,
///   max_decode_depth: 128,
///   modules: [transport.module("shared")],
/// )
/// ```
///
/// ## Supported shapes
///
/// - Primitives, `Int`, `Float`, `String`, `Bool`, `Nil`. An `Int` must be
///   within 2^53 - 1 either side of zero, the range both targets hold
///   exactly, a `Float` must be finite and a `String` can't hold a lone
///   surrogate. Encoding refuses anything else, and so does decoding.
/// - Custom types, records and variants, a tagged map whose `_` field carries
///   the PascalCase constructor name.
/// - Lists, as arrays.
/// - Tuples, `#(a, b)` as tag-less maps with positional keys
///   (`{"0":a,"1":b}`).
/// - `gleam/dict.Dict`, as `{"_":"$dict","0":[[k,v],...]}`.
/// - `gleam/set.Set`, as `{"_":"$set","0":[v,...]}`.
///
/// ## Not supported
///
/// A tuple whose first element is a `Bool`, `Nil` or a zero-field
/// constructor, `#(True, x)` say, looks like a custom type on Erlang and is
/// written as one. JavaScript reads it back as the tuple, unless a constructor
/// with that name and arity is registered, so keep such names distinct.
///
/// A one-field constructor of your own named `Set` holding a `Dict` looks
/// like `gleam/set.Set` on Erlang and is written as one, so name it something
/// else.
///
/// `BitArray` fields are not encoded, since on Erlang they can't be told
/// apart from a `String`. Wrap raw bytes in a type of your own and write a
/// [`serialiser`](#serialiser) that base64-encodes them:
///
/// ```gleam
/// pub type Bytes {
///   Bytes(data: BitArray)
/// }
/// ```
pub fn automatic(
  format format: Format,
  max_decode_depth max_decode_depth: Int,
  modules modules: List(Module),
) -> Serialiser(model, message) {
  list.each(modules, fn(entry) {
    codec.request_module(entry.package, entry.path)
  })
  Automatic(format:, max_decode_depth:)
}

/// Wraps a `connect` function as a [`Connector`](#Connector), for a transport
/// of your own.
///
/// `connect` gets the [`ConnectorHandler`](#ConnectorHandler) to call and
/// returns the [`Channel`](#Channel) to send frames through. Wrap the result
/// in [`with_offline_queue`](#with_offline_queue) to queue frames sent while
/// it is down.
pub fn connector(
  connect connect: fn(ConnectorHandler) -> Channel,
) -> Connector {
  Connector(connect:, pending: fn() { [] }, queues: False)
}

/// A constructor and its field types, for a [`Schema`](#Schema).
///
/// ```gleam
/// transport.constructor(name: "SetName", fields: [transport.StringType])
/// ```
pub fn constructor(
  name name: String,
  fields fields: List(WireType),
) -> ConstructorDefinition {
  ConstructorDefinition(name:, fields:)
}

/// A custom type and its constructors, for a [`Schema`](#Schema).
///
/// ```gleam
/// transport.custom(module: "shared", name: "Message", constructors: [
///   transport.constructor(name: "Increment", fields: []),
/// ])
/// ```
pub fn custom(
  module module: String,
  name name: String,
  constructors constructors: List(ConstructorDefinition),
) -> CustomDefinition {
  CustomDefinition(module:, name:, constructors:)
}

/// Decodes bytes into a [`Protocol`](#Protocol) frame. A serialiser of your
/// own that crashes counts as a failure.
pub fn decode(
  bytes: BitArray,
  serialiser serialiser: Serialiser(model, message),
) -> Result(Protocol(model, message), Nil) {
  decode_inbound(bytes, serialiser:, conform: Ok, from_client: False)
  |> result.map(pair.first)
  |> result.replace_error(Nil)
}

/// Encodes a [`Protocol`](#Protocol) frame into bytes, in the serialiser's
/// format.
///
/// `ByHost` writes MessagePack where there is no page, such as on the server.
///
/// The automatic serialiser raises for a value it can't write, an `Int` past
/// the wire range, a non-finite `Float` or a lone surrogate, see
/// [`automatic`](#automatic). Lily's own calls are rescued, so a frame of
/// yours should only hold values in range.
pub fn encode(
  protocol: Protocol(model, message),
  serialiser serialiser: Serialiser(model, message),
) -> BitArray {
  case serialiser {
    Automatic(format:, ..) -> encode_in(protocol, format)
    Open(encode:, ..) -> encode(protocol)
  }
}

/// Names a module whose types are sent over the wire, by its path.
///
/// The first segment is taken as the package, meaning `module("shared")` is
/// module `shared` in package `shared`, and `module("shared/views/note")` is
/// that package's `views/note`. Use [`module_in`](#module_in) when the package
/// has another name.
pub fn module(path: String) -> Module {
  let package = case string.split(path, "/") {
    [first, ..] -> first
    [] -> path
  }
  Module(package:, path:)
}

/// Names a module in `package`, for when the package isn't the first segment
/// of the path, as with a dependency.
///
/// ```gleam
/// transport.module_in(package: "some_dep", path: "some/dep/module")
/// ```
pub fn module_in(package package: String, path path: String) -> Module {
  Module(package:, path:)
}

/// Builds a [`Schema`](#Schema) from the root message and model types and
/// every custom type they reach. `lily/dev schema` writes this call for you.
///
/// ```gleam
/// transport.schema(
///   message: transport.Custom("shared", "Message", []),
///   model: transport.Custom("shared", "Model", []),
///   types: [message_type, model_type],
/// )
/// ```
pub fn schema(
  message message: WireType,
  model model: WireType,
  types types: List(CustomDefinition),
) -> Schema {
  let types =
    list.fold(types, dict.new(), fn(index, definition) {
      let constructors =
        list.map(definition.constructors, fn(constructor) {
          #(constructor.name, constructor.fields)
        })
        |> dict.from_list
      dict.insert(index, #(definition.module, definition.name), constructors)
    })
  Schema(message:, model:, types:)
}

/// Creates a serialiser from your own functions that encode and decode a
/// whole [`Protocol`](#Protocol) frame, for when [`automatic`](#automatic)
/// doesn't fit.
pub fn serialiser(
  encode encode: fn(Protocol(model, message)) -> BitArray,
  decode decode: fn(BitArray) -> Result(Protocol(model, message), Nil),
) -> Serialiser(model, message) {
  Open(encode:, decode:)
}

/// Connects to the server over a WebSocket at `url`, reconnecting with the
/// default backoff. Pass it to [`client.connect`](./client.html#connect).
///
/// `url` may be relative, `/ws` becomes `wss://host/ws` on an https page.
/// Frames sent while disconnected are queued and sent when it reconnects.
///
/// ```gleam
/// client.connect(runtime, with: transport.websocket("/ws"))
/// ```
pub fn websocket(url: String) -> Connector {
  websocket_with(url:, reconnect: DefaultBackoff)
}

/// Like [`websocket`](#websocket), with a [`Reconnect`](#Reconnect) policy of
/// your own.
///
/// ```gleam
/// transport.websocket_with(
///   url: "/ws",
///   reconnect: transport.Backoff(
///     base_milliseconds: 2000,
///     max_milliseconds: 60_000,
///     jitter_ratio: 0.25,
///     multiplier: 2.0,
///   ),
/// )
/// ```
pub fn websocket_with(
  url url: String,
  reconnect reconnect: Reconnect,
) -> Connector {
  let #(base_milliseconds, max_milliseconds, jitter_ratio, multiplier) = case
    reconnect
  {
    DefaultBackoff -> #(1000, 30_000, 0.25, 2.0)
    Backoff(base_milliseconds:, max_milliseconds:, jitter_ratio:, multiplier:) -> #(
      base_milliseconds,
      max_milliseconds,
      jitter_ratio,
      multiplier,
    )
  }
  connector(fn(handler: ConnectorHandler) {
    ffi_websocket_connect(
      url,
      base_milliseconds,
      max_milliseconds,
      jitter_ratio,
      multiplier,
      handler,
      Channel,
    )
  })
  |> with_offline_queue(storage_key: "lily_ws_pending")
}

/// Holds frames a connector couldn't send and sends them, in order, when it
/// next opens.
///
/// The queue is kept in `sessionStorage` under `storage_key`, letting it
/// survive a reload without being shared between tabs. Your
/// [`Channel`](#Channel)'s `send` must return `Error` for a frame that didn't
/// go out.
///
/// The first frame sent after the connection opens goes out ahead of the
/// queue, which follows right behind it. That's where the client sends its
/// `Resync`, letting the server rejoin your topics before your offline edits
/// reach them.
pub fn with_offline_queue(
  inner: Connector,
  storage_key storage_key: String,
) -> Connector {
  Connector(
    connect: fn(handler: ConnectorHandler) {
      ffi_offline_connect(
        inner.connect,
        storage_key,
        queue_version,
        handler,
        ConnectorHandler,
        Channel,
      )
    },
    pending: fn() { ffi_offline_pending(storage_key, queue_version) },
    queues: True,
  )
}

// =============================================================================
// INTERNAL TYPES
// =============================================================================

/// The check a decoded message payload gets, from
/// [`message_conformer`](#message_conformer).
@internal
pub type Conformer =
  fn(Reflected) -> Result(Reflected, Nil)

/// Why an inbound frame didn't decode.
@internal
pub type DecodeFailure {
  /// Not a frame at all, or one whose fields are wrong
  Malformed
  /// A message for `target` whose payload didn't decode or fails the schema
  Nonconforming(target: SyncTarget)
}

// =============================================================================
// INTERNAL FUNCTIONS
// =============================================================================

// bumped when a frame's shape changes
@internal
pub const protocol_version = 1

/// For the schema tests, the server decodes through `decode_inbound`. Only the
/// automatic serialiser is checked, and only message payloads.
@internal
pub fn decode_checked(
  bytes: BitArray,
  serialiser serialiser: Serialiser(model, message),
  schema schema: Option(Schema),
) -> Result(Protocol(model, message), Nil) {
  decode_inbound(
    bytes,
    serialiser:,
    conform: message_conformer(schema),
    from_client: False,
  )
  |> result.map(pair.first)
  |> result.replace_error(Nil)
}

/// Decodes a frame once, with the format it came in when the serialiser is
/// automatic, checking message payloads with `conform` from
/// [`message_conformer`](#message_conformer). A crashing decoder of your own
/// is `Malformed`. A frame `from_client` may only carry a tag a client sends,
/// the rest are refused before their payload is read.
@internal
pub fn decode_inbound(
  bytes: BitArray,
  serialiser serialiser: Serialiser(model, message),
  conform conform: Conformer,
  from_client from_client: Bool,
) -> Result(#(Protocol(model, message), Option(Format)), DecodeFailure) {
  case
    rescue(fn() { decode_conformed(bytes, serialiser, conform, from_client) })
  {
    // a serialiser of your own decodes any tag, the frame is refused after
    Ok(Ok(#(protocol, format))) ->
      case from_client && !is_client_frame(protocol) {
        True -> Error(Malformed)
        False -> Ok(#(protocol, format))
      }
    Ok(Error(failure)) -> Error(failure)
    Error(_) -> Error(Malformed)
  }
}

/// A serialiser of your own ignores `format`.
@internal
pub fn encode_as(
  protocol: Protocol(model, message),
  serialiser serialiser: Serialiser(model, message),
  format format: Format,
) -> BitArray {
  case serialiser {
    Automatic(..) -> encode_in(protocol, format)
    Open(encode:, ..) -> encode(protocol)
  }
}

@internal
pub fn format_for_host(format: Format, hostname: String) -> Format {
  case format {
    Json -> Json
    MessagePack -> MessagePack
    ByHost ->
      case is_local_host(hostname) {
        True -> Json
        False -> MessagePack
      }
  }
}

@internal
pub fn frame_format(
  bytes: BitArray,
  serialiser serialiser: Serialiser(model, message),
) -> Result(Format, Nil) {
  case serialiser {
    Automatic(..) -> detect_format(bytes)
    Open(..) -> Error(Nil)
  }
}

@internal
pub fn is_automatic(serialiser: Serialiser(model, message)) -> Bool {
  case serialiser {
    Automatic(..) -> True
    Open(..) -> False
  }
}

@internal
pub fn is_local_page() -> Bool {
  is_local_host(page_hostname())
}

/// The check a client message gets under `schema`, `Ok` without one.
@internal
pub fn message_conformer(schema: Option(Schema)) -> Conformer {
  case schema {
    option.None -> Ok
    option.Some(schema) -> fn(reflected) {
      conform(schema, reflected, schema.message, [])
    }
  }
}

/// Which store a message frame is for, read from the frame's head without
/// decoding its payload. `None` for anything else or a frame it can't read.
@internal
pub fn peek_target(bytes: BitArray) -> Option(SyncTarget) {
  // lily writes `type` first, then a topic message's `topic_id`
  let head = case detect_format(bytes) {
    Ok(MessagePack) -> codec.leading_strings(bytes, 2)
    Ok(Json) -> json_leading_strings(bytes)
    Ok(ByHost) | Error(Nil) -> []
  }
  case head {
    [#("type", "session_message"), ..] -> option.Some(Session)
    [#("type", "topic_message"), #("topic_id", id), ..] ->
      wire_string(id) |> result.map(Topic) |> option.from_result
    _ -> option.None
  }
}

/// Includes frames left over from before a reload.
@internal
pub fn pending(connector: Connector) -> List(BitArray) {
  connector.pending()
}

/// Whether a frame whose send failed is held and sent later.
@internal
pub fn queues(connector: Connector) -> Bool {
  connector.queues
}

@internal
pub fn resolve_for_page(
  serialiser: Serialiser(model, message),
) -> Serialiser(model, message) {
  case serialiser {
    Automatic(format:, max_decode_depth:) ->
      Automatic(
        format: format_for_host(format, page_hostname()),
        max_decode_depth:,
      )
    Open(..) -> serialiser
  }
}

@internal
pub fn run_connector(
  connector: Connector,
  handler: ConnectorHandler,
) -> Channel {
  connector.connect(handler)
}

/// What a server writes before a client has said which format it speaks.
@internal
pub fn server_format(serialiser: Serialiser(model, message)) -> Format {
  case serialiser {
    Automatic(format:, ..) -> format_for_host(format, "")
    Open(..) -> MessagePack
  }
}

// =============================================================================
// PRIVATE TYPES
// =============================================================================

type Reader(model, message) {
  Reader(
    int: fn(String) -> Result(Int, Nil),
    message: fn(String) -> Result(message, Nil),
    model: fn(String) -> Result(model, Nil),
    string: fn(String) -> Result(String, Nil),
    target: fn(String) -> Result(SyncTarget, Nil),
    cursors: fn(String) -> Result(List(Cursor), Nil),
  )
}

type Writer(model, message, field) {
  Writer(
    int: fn(Int) -> field,
    message: fn(message) -> field,
    model: fn(model) -> field,
    string: fn(String) -> field,
    target: fn(SyncTarget) -> field,
    cursors: fn(List(Cursor)) -> field,
  )
}

// =============================================================================
// PRIVATE FUNCTIONS
// =============================================================================

// the queued frames' shape, a session or topic message, bumped only when
// those change so a protocol bump keeps the edits a page left offline
const queue_version = 1

// failure value never read, only needs the decoder's type
fn automatic_decoder(
  max_depth: Int,
  conform: Conformer,
) -> decode.Decoder(value) {
  decode.new_primitive_decoder("Automatic", fn(value) {
    case codec.decode_json(value, max_depth, conform) {
      Ok(decoded) -> Ok(codec.passthrough(decoded))
      Error(_) -> Error(codec.passthrough(value))
    }
  })
}

// shared by both formats so they agree on a frame's fields
fn build(
  reader: Reader(model, message),
  from_client: Bool,
) -> Result(Protocol(model, message), DecodeFailure) {
  use tag <- result.try(malformed(reader.string("type")))
  // a server frame from a client would be dropped anyway, its payload unread,
  // these are the tags a client sends
  let client_tag =
    list.contains(
      ["resync", "session_message", "subscribe", "topic_message", "unsubscribe"],
      tag,
    )
  use <- bool.guard(when: from_client && !client_tag, return: Error(Malformed))
  case tag {
    "acknowledge" -> {
      use target <- result.try(malformed(reader.target("target")))
      use sequence <- result.try(malformed(reader.int("sequence")))
      Ok(Acknowledge(target:, sequence:))
    }
    "connected" -> {
      use client_id <- result.try(malformed(reader.string("client_id")))
      Ok(Connected(client_id:))
    }
    "dropped" -> {
      use target <- result.try(malformed(reader.target("target")))
      Ok(Dropped(target:))
    }
    "rejected" -> {
      use topic_id <- result.try(malformed(reader.string("topic_id")))
      use reason <- result.try(
        reader.string("reason")
        |> result.try(rejection_reason_from_wire)
        |> malformed,
      )
      Ok(Rejected(topic_id:, reason:))
    }
    "resync" -> {
      use cursors <- result.try(malformed(reader.cursors("cursors")))
      Ok(Resync(cursors:))
    }
    "session_message" -> {
      use payload <- result.try(
        reader.message("payload")
        |> result.replace_error(Nonconforming(target: Session)),
      )
      Ok(SessionMessage(payload:))
    }
    "session_update" -> {
      use sequence <- result.try(malformed(reader.int("sequence")))
      use payload <- result.try(malformed(reader.message("payload")))
      Ok(SessionUpdate(sequence:, payload:))
    }
    "snapshot" -> {
      use target <- result.try(malformed(reader.target("target")))
      use epoch <- result.try(malformed(reader.int("epoch")))
      use sequence <- result.try(malformed(reader.int("sequence")))
      use state <- result.try(malformed(reader.model("state")))
      Ok(Snapshot(target:, epoch:, sequence:, state:))
    }
    "subscribe" -> {
      use topic_id <- result.try(malformed(reader.string("topic_id")))
      Ok(Subscribe(topic_id:))
    }
    "topic_message" -> {
      use topic_id <- result.try(malformed(reader.string("topic_id")))
      use payload <- result.try(
        reader.message("payload")
        |> result.replace_error(Nonconforming(target: Topic(topic_id))),
      )
      Ok(TopicMessage(topic_id:, payload:))
    }
    "topic_update" -> {
      use topic_id <- result.try(malformed(reader.string("topic_id")))
      use sequence <- result.try(malformed(reader.int("sequence")))
      use payload <- result.try(malformed(reader.message("payload")))
      Ok(TopicUpdate(topic_id:, sequence:, payload:))
    }
    "unchanged" -> {
      use target <- result.try(malformed(reader.target("target")))
      Ok(Unchanged(target:))
    }
    "unsubscribe" -> {
      use topic_id <- result.try(malformed(reader.string("topic_id")))
      Ok(Unsubscribe(topic_id:))
    }
    "version" -> {
      use hash <- result.try(malformed(reader.string("hash")))
      use protocol <- result.try(malformed(reader.int("protocol")))
      Ok(Version(hash:, protocol:))
    }
    _ -> Error(Malformed)
  }
}

// whole-number floats arrive as ints from JavaScript, rebuilt as floats
fn conform(
  schema: Schema,
  reflected: Reflected,
  expected: WireType,
  parameters: List(WireType),
) -> Result(Reflected, Nil) {
  let walk = fn(value, expected) {
    conform(schema, value, expected, parameters)
  }
  case expected, reflected {
    Anything, _
    | BoolType, ReflectedBool(_)
    | FloatType, ReflectedFloat(_)
    | IntType, ReflectedInteger(_)
    | NilType, ReflectedNil
    | StringType, ReflectedString(_)
    -> Ok(reflected)
    FloatType, ReflectedInteger(value) ->
      Ok(ReflectedFloat(int.to_float(value)))
    ListOf(item), ReflectedList(items) ->
      list.try_map(items, walk(_, item)) |> result.map(ReflectedList)
    SetOf(member), ReflectedSet(members:) ->
      list.try_map(members, walk(_, member))
      |> result.map(fn(members) { ReflectedSet(members:) })
    DictOf(key:, value:), ReflectedDict(entries:) ->
      list.try_map(entries, fn(entry) {
        use entry_key <- result.try(walk(entry.0, key))
        use entry_value <- result.try(walk(entry.1, value))
        Ok(#(entry_key, entry_value))
      })
      |> result.map(fn(entries) { ReflectedDict(entries:) })
    TupleOf(types), ReflectedTuple(fields:) ->
      conform_fields(fields, types, walk)
      |> result.map(fn(fields) { ReflectedTuple(fields:) })
    Custom(module:, name:, parameters: arguments),
      ReflectedConstructor(name: tag, fields:)
    -> {
      use constructors <- result.try(dict.get(schema.types, #(module, name)))
      use field_types <- result.try(dict.get(constructors, tag))
      let arguments = list.map(arguments, substitute(_, parameters))
      conform_fields(fields, field_types, fn(value, expected) {
        conform(schema, value, expected, arguments)
      })
      |> result.map(fn(fields) { ReflectedConstructor(name: tag, fields:) })
    }
    Variable(index:), _ ->
      case parameter_at(parameters, index) {
        Ok(bound) -> conform(schema, reflected, bound, [])
        Error(Nil) -> Ok(reflected)
      }
    _, _ -> Error(Nil)
  }
}

fn conform_fields(
  fields: List(Reflected),
  types: List(WireType),
  walk: fn(Reflected, WireType) -> Result(Reflected, Nil),
) -> Result(List(Reflected), Nil) {
  case list.strict_zip(fields, types) {
    Ok(pairs) -> list.try_map(pairs, fn(pair) { walk(pair.0, pair.1) })
    Error(Nil) -> Error(Nil)
  }
}

// a target with an epoch and a sequence when the client knows both, one
// without the other isn't a cursor
fn cursor_decoder() -> decode.Decoder(Cursor) {
  use target <- decode.then(target_decoder())
  let number = decode.map(decode.int, option.Some)
  use epoch <- decode.optional_field("epoch", option.None, number)
  use sequence <- decode.optional_field("sequence", option.None, number)
  case epoch, sequence {
    option.Some(epoch), option.Some(sequence) ->
      decode.success(Known(target:, epoch:, sequence:))
    option.None, option.None -> decode.success(Unknown(target:))
    option.Some(_), option.None | option.None, option.Some(_) ->
      decode.failure(Unknown(target:), "Cursor")
  }
}

// `conform` checks message payloads only, a serialiser of your own decides
// for itself what a client may send, and only the automatic one has a format
fn decode_conformed(
  bytes: BitArray,
  serialiser: Serialiser(model, message),
  conform: Conformer,
  from_client: Bool,
) -> Result(#(Protocol(model, message), Option(Format)), DecodeFailure) {
  let found = fn(decoded, format) {
    result.map(decoded, pair.new(_, option.Some(format)))
  }
  case serialiser {
    Automatic(max_decode_depth:, ..) ->
      case detect_format(bytes) {
        Ok(Json) ->
          decode_json(bytes, max_decode_depth, conform, from_client)
          |> found(Json)
        Ok(MessagePack) ->
          decode_message_pack(bytes, max_decode_depth, conform, from_client)
          |> found(MessagePack)
        Ok(ByHost) | Error(Nil) -> Error(Malformed)
      }
    Open(decode:, ..) ->
      malformed(decode(bytes)) |> result.map(pair.new(_, option.None))
  }
}

fn decode_cursor_message_pack(value: MessagePackValue) -> Result(Cursor, Nil) {
  use target <- result.try(decode_target_message_pack(value))
  let number = fn(key) {
    case value {
      ValueMap(entries) ->
        case codec.lookup_string_key(entries, key) {
          Ok(ValueInteger(number)) -> Ok(option.Some(number))
          Ok(_) -> Error(Nil)
          Error(Nil) -> Ok(option.None)
        }
      _ -> Error(Nil)
    }
  }
  use epoch <- result.try(number("epoch"))
  use sequence <- result.try(number("sequence"))
  case epoch, sequence {
    option.Some(epoch), option.Some(sequence) ->
      Ok(Known(target:, epoch:, sequence:)) |> result.try(wire_cursor)
    option.None, option.None -> Ok(Unknown(target:))
    option.Some(_), option.None | option.None, option.Some(_) -> Error(Nil)
  }
}

fn decode_json(
  bytes: BitArray,
  max_depth: Int,
  conform: Conformer,
  from_client: Bool,
) -> Result(Protocol(model, message), DecodeFailure) {
  // a payload the platform parser refuses, `1e400` on Erlang say, is still a
  // message whose head says which edit to roll back
  let parsed =
    bit_array.to_string(bytes)
    |> result.try(fn(text) {
      json.parse(from: text, using: decode.dynamic)
      |> result.replace_error(Nil)
    })
  case parsed {
    Ok(value) -> build(json_reader(value, max_depth, conform), from_client)
    Error(Nil) ->
      case peek_target(bytes) {
        option.Some(target) -> Error(Nonconforming(target:))
        option.None -> Error(Malformed)
      }
  }
}

fn decode_message_pack(
  bytes: BitArray,
  max_depth: Int,
  conform: Conformer,
  from_client: Bool,
) -> Result(Protocol(model, message), DecodeFailure) {
  use top_value <- result.try(malformed(codec.decode_whole(bytes, max_depth)))
  case top_value {
    ValueMap(entries) ->
      build(message_pack_reader(entries, max_depth, conform), from_client)
    _ -> Error(Malformed)
  }
}

fn decode_target_message_pack(
  value: MessagePackValue,
) -> Result(SyncTarget, Nil) {
  case value {
    ValueMap(entries) ->
      case
        codec.lookup_string_key(entries, "kind"),
        codec.lookup_string_key(entries, "id")
      {
        Ok(ValueString("session")), _ -> Ok(Session)
        Ok(ValueString("topic")), Ok(ValueString(id)) ->
          wire_string(id) |> result.map(Topic)
        _, _ -> Error(Nil)
      }
    _ -> Error(Nil)
  }
}

// every frame is a map (JSON object or MessagePack map), first byte decides
fn detect_format(bytes: BitArray) -> Result(Format, Nil) {
  case bytes {
    <<0xDE, _:bits>> | <<0xDF, _:bits>> -> Ok(MessagePack)
    <<marker, _:bits>> if marker >= 0x80 && marker <= 0x8F -> Ok(MessagePack)
    _ -> detect_json_format(bytes)
  }
}

// leading whitespace is never a MessagePack map marker, making it JSON
fn detect_json_format(bytes: BitArray) -> Result(Format, Nil) {
  case bytes {
    <<0x7B, _:bits>> -> Ok(Json)
    <<0x20, rest:bits>>
    | <<0x09, rest:bits>>
    | <<0x0A, rest:bits>>
    | <<0x0D, rest:bits>> -> detect_json_format(rest)
    _ -> Error(Nil)
  }
}

fn encode_cursor_json(cursor: Cursor) -> Json {
  case cursor {
    Unknown(target:) -> encode_target_json(target)
    Known(target:, epoch:, sequence:) ->
      json.object(
        list.append(target_fields_json(target), [
          #("epoch", codec.json_int(epoch)),
          #("sequence", codec.json_int(sequence)),
        ]),
      )
  }
}

fn encode_cursor_message_pack(cursor: Cursor) -> BitArray {
  let encode_string = codec.encode_string
  case cursor {
    Unknown(target:) -> encode_target_message_pack(target)
    Known(target:, epoch:, sequence:) ->
      codec.encode_map(
        list.append(target_fields_message_pack(target), [
          #(encode_string("epoch"), codec.encode_int(epoch)),
          #(encode_string("sequence"), codec.encode_int(sequence)),
        ]),
      )
  }
}

fn encode_in(protocol: Protocol(model, message), format: Format) -> BitArray {
  case format {
    Json -> encode_json(protocol)
    MessagePack -> encode_message_pack(protocol)
    ByHost -> encode_in(protocol, format_for_host(ByHost, page_hostname()))
  }
}

fn encode_json(protocol: Protocol(model, message)) -> BitArray {
  let writer =
    Writer(
      int: codec.json_int,
      message: codec.encode_json,
      model: codec.encode_json,
      string: json.string,
      target: encode_target_json,
      cursors: json.array(_, encode_cursor_json),
    )
  let #(tag, fields) = frame_fields(protocol, writer)
  json.object([#("type", json.string(tag)), ..fields])
  |> json.to_string
  |> bit_array.from_string
}

fn encode_message_pack(protocol: Protocol(model, message)) -> BitArray {
  let encode_string = codec.encode_string
  let writer =
    Writer(
      int: codec.encode_int,
      message: payload_bin,
      model: payload_bin,
      string: encode_string,
      target: encode_target_message_pack,
      cursors: fn(cursors) {
        codec.encode_array(list.map(cursors, encode_cursor_message_pack))
      },
    )
  let #(tag, fields) = frame_fields(protocol, writer)
  let entries =
    list.map(fields, fn(field) { #(encode_string(field.0), field.1) })
  codec.encode_map([#(encode_string("type"), encode_string(tag)), ..entries])
}

fn encode_target_json(target: SyncTarget) -> Json {
  json.object(target_fields_json(target))
}

fn encode_target_message_pack(target: SyncTarget) -> BitArray {
  codec.encode_map(target_fields_message_pack(target))
}

// field order is part of the wire format
fn frame_fields(
  protocol: Protocol(model, message),
  writer: Writer(model, message, field),
) -> #(String, List(#(String, field))) {
  case protocol {
    Acknowledge(target:, sequence:) -> #("acknowledge", [
      #("target", writer.target(target)),
      #("sequence", writer.int(sequence)),
    ])
    Connected(client_id:) -> #("connected", [
      #("client_id", writer.string(client_id)),
    ])
    Dropped(target:) -> #("dropped", [#("target", writer.target(target))])
    Rejected(topic_id:, reason:) -> #("rejected", [
      #("topic_id", writer.string(topic_id)),
      #("reason", writer.string(rejection_reason_to_wire(reason))),
    ])
    Resync(cursors:) -> #("resync", [#("cursors", writer.cursors(cursors))])
    SessionMessage(payload:) -> #("session_message", [
      #("payload", writer.message(payload)),
    ])
    SessionUpdate(sequence:, payload:) -> #("session_update", [
      #("sequence", writer.int(sequence)),
      #("payload", writer.message(payload)),
    ])
    Snapshot(target:, epoch:, sequence:, state:) -> #("snapshot", [
      #("target", writer.target(target)),
      #("epoch", writer.int(epoch)),
      #("sequence", writer.int(sequence)),
      #("state", writer.model(state)),
    ])
    Subscribe(topic_id:) -> #("subscribe", [
      #("topic_id", writer.string(topic_id)),
    ])
    TopicMessage(topic_id:, payload:) -> #("topic_message", [
      #("topic_id", writer.string(topic_id)),
      #("payload", writer.message(payload)),
    ])
    TopicUpdate(topic_id:, sequence:, payload:) -> #("topic_update", [
      #("topic_id", writer.string(topic_id)),
      #("sequence", writer.int(sequence)),
      #("payload", writer.message(payload)),
    ])
    Unchanged(target:) -> #("unchanged", [#("target", writer.target(target))])
    Unsubscribe(topic_id:) -> #("unsubscribe", [
      #("topic_id", writer.string(topic_id)),
    ])
    Version(hash:, protocol:) -> #("version", [
      #("hash", writer.string(hash)),
      #("protocol", writer.int(protocol)),
    ])
  }
}

// for a serialiser of your own, the automatic one checks the tag first
fn is_client_frame(protocol: Protocol(model, message)) -> Bool {
  case protocol {
    Resync(..)
    | SessionMessage(..)
    | Subscribe(..)
    | TopicMessage(..)
    | Unsubscribe(..) -> True
    Acknowledge(..)
    | Connected(..)
    | Dropped(..)
    | Rejected(..)
    | SessionUpdate(..)
    | Snapshot(..)
    | TopicUpdate(..)
    | Unchanged(..)
    | Version(..) -> False
  }
}

fn is_local_host(hostname: String) -> Bool {
  hostname == "localhost" || hostname == "127.0.0.1" || hostname == "[::1]"
}

fn json_expect(bytes: BitArray, byte: Int) -> Result(BitArray, Nil) {
  case bytes {
    <<found, rest:bytes>> if found == byte -> Ok(rest)
    _ -> Error(Nil)
  }
}

fn json_field(
  value: Dynamic,
  key: String,
  decoder: decode.Decoder(field),
) -> Result(field, Nil) {
  decode.run(value, decode.at([key], decoder))
  |> result.replace_error(Nil)
}

// a JSON string at the front, unescaped by the JSON parser, bounded so a
// hostile frame can't make the scan long
fn json_head_string(bytes: BitArray) -> Result(#(String, BitArray), Nil) {
  use rest <- result.try(json_expect(bytes, 0x22))
  use length <- result.try(json_string_length(rest, 0))
  use raw <- result.try(bit_array.slice(rest, 0, length))
  use after <- result.try(bit_array.slice(
    rest,
    length + 1,
    bit_array.byte_size(rest) - length - 1,
  ))
  use text <- result.try(bit_array.to_string(raw))
  use value <- result.try(
    json.parse(from: "\"" <> text <> "\"", using: decode.string)
    |> result.replace_error(Nil),
  )
  use value <- result.map(wire_string(value))
  #(value, after)
}

// the first two string pairs of a JSON object, read by hand from the front
// so nothing after them is parsed
fn json_leading_strings(bytes: BitArray) -> List(#(String, String)) {
  let pair = fn(bytes, opener) {
    use rest <- result.try(json_expect(json_skip_space(bytes), opener))
    use #(key, rest) <- result.try(json_head_string(json_skip_space(rest)))
    use rest <- result.try(json_expect(json_skip_space(rest), 0x3A))
    use #(value, rest) <- result.map(json_head_string(json_skip_space(rest)))
    #(#(key, value), rest)
  }
  case pair(bytes, 0x7B) {
    Error(Nil) -> []
    Ok(#(first, rest)) ->
      case pair(rest, 0x2C) {
        Ok(#(second, _)) -> [first, second]
        Error(Nil) -> [first]
      }
  }
}

fn json_reader(
  value: Dynamic,
  max_depth: Int,
  conform: Conformer,
) -> Reader(model, message) {
  Reader(
    int: fn(key) { json_field(value, key, decode.int) |> result.try(wire_int) },
    message: json_field(value, _, automatic_decoder(max_depth, conform)),
    model: json_field(value, _, automatic_decoder(max_depth, Ok)),
    string: fn(key) {
      json_field(value, key, decode.string) |> result.try(wire_string)
    },
    target: fn(key) {
      json_field(value, key, target_decoder()) |> result.try(wire_target)
    },
    cursors: fn(key) {
      json_field(value, key, decode.list(cursor_decoder()))
      |> result.try(list.try_map(_, wire_cursor))
    },
  )
}

// leading whitespace, as JSON allows it between tokens
fn json_skip_space(bytes: BitArray) -> BitArray {
  case bytes {
    <<0x20, rest:bytes>>
    | <<0x09, rest:bytes>>
    | <<0x0A, rest:bytes>>
    | <<0x0D, rest:bytes>> -> json_skip_space(rest)
    _ -> bytes
  }
}

// bytes before the closing quote, an escape skips the byte after it
fn json_string_length(bytes: BitArray, length: Int) -> Result(Int, Nil) {
  case bytes {
    _ if length > 4096 -> Error(Nil)
    <<0x22, _:bytes>> -> Ok(length)
    <<0x5C, _, rest:bytes>> -> json_string_length(rest, length + 2)
    <<_, rest:bytes>> -> json_string_length(rest, length + 1)
    _ -> Error(Nil)
  }
}

fn malformed(result: Result(value, Nil)) -> Result(value, DecodeFailure) {
  result.replace_error(result, Malformed)
}

fn message_pack_payload(
  value: Result(MessagePackValue, Nil),
  max_depth: Int,
  conform: Conformer,
) -> Result(payload, Nil) {
  case value {
    Ok(ValueBytes(bytes)) ->
      codec.decode_message_pack(bytes, max_depth, conform)
      |> result.map(codec.passthrough)
    _ -> Error(Nil)
  }
}

fn message_pack_reader(
  entries: List(#(MessagePackValue, MessagePackValue)),
  max_depth: Int,
  conform: Conformer,
) -> Reader(model, message) {
  let lookup = codec.lookup_string_key(entries, _)
  Reader(
    int: fn(key) {
      case lookup(key) {
        Ok(ValueInteger(value)) -> wire_int(value)
        _ -> Error(Nil)
      }
    },
    message: fn(key) { message_pack_payload(lookup(key), max_depth, conform) },
    model: fn(key) { message_pack_payload(lookup(key), max_depth, Ok) },
    string: fn(key) {
      case lookup(key) {
        Ok(ValueString(text)) -> wire_string(text)
        _ -> Error(Nil)
      }
    },
    target: fn(key) { lookup(key) |> result.try(decode_target_message_pack) },
    cursors: fn(key) {
      case lookup(key) {
        Ok(ValueArray(items)) -> list.try_map(items, decode_cursor_message_pack)
        _ -> Error(Nil)
      }
    },
  )
}

fn parameter_at(
  parameters: List(WireType),
  index: Int,
) -> Result(WireType, Nil) {
  list.drop(parameters, index) |> list.first
}

fn payload_bin(value: payload) -> BitArray {
  codec.encode_bin(codec.encode_message_pack(value))
}

fn rejection_reason_from_wire(text: String) -> Result(RejectionReason, Nil) {
  case text {
    "denied" -> Ok(AccessDenied)
    "limit" -> Ok(OverLimit)
    "not found" -> Ok(NotFound)
    _ -> Error(Nil)
  }
}

fn rejection_reason_to_wire(reason: RejectionReason) -> String {
  case reason {
    AccessDenied -> "denied"
    NotFound -> "not found"
    OverLimit -> "limit"
  }
}

// an unbound variable is unchecked
fn substitute(wire_type: WireType, parameters: List(WireType)) -> WireType {
  case wire_type {
    Variable(index:) ->
      parameter_at(parameters, index) |> result.unwrap(Anything)
    ListOf(item) -> ListOf(substitute(item, parameters))
    SetOf(member) -> SetOf(substitute(member, parameters))
    DictOf(key:, value:) ->
      DictOf(
        key: substitute(key, parameters),
        value: substitute(value, parameters),
      )
    TupleOf(types) -> TupleOf(list.map(types, substitute(_, parameters)))
    Custom(module:, name:, parameters: arguments) ->
      Custom(
        module:,
        name:,
        parameters: list.map(arguments, substitute(_, parameters)),
      )
    Anything | BoolType | FloatType | IntType | NilType | StringType ->
      wire_type
  }
}

fn target_decoder() -> decode.Decoder(SyncTarget) {
  use kind <- decode.field("kind", decode.string)
  case kind {
    "session" -> decode.success(Session)
    "topic" -> {
      use id <- decode.field("id", decode.string)
      decode.success(Topic(id:))
    }
    _ -> decode.failure(Session, "SyncTarget")
  }
}

fn target_fields_json(target: SyncTarget) -> List(#(String, Json)) {
  case target {
    Session -> [#("kind", json.string("session"))]
    Topic(id:) -> [#("kind", json.string("topic")), #("id", json.string(id))]
  }
}

fn target_fields_message_pack(
  target: SyncTarget,
) -> List(#(BitArray, BitArray)) {
  let encode_string = codec.encode_string
  case target {
    Session -> [#(encode_string("kind"), encode_string("session"))]
    Topic(id:) -> [
      #(encode_string("kind"), encode_string("topic")),
      #(encode_string("id"), encode_string(id)),
    ]
  }
}

fn wire_cursor(cursor: Cursor) -> Result(Cursor, Nil) {
  case cursor {
    Unknown(target:) -> wire_target(target) |> result.map(Unknown)
    Known(target:, epoch:, sequence:) -> {
      use target <- result.try(wire_target(target))
      use epoch <- result.try(wire_int(epoch))
      use sequence <- result.try(wire_int(sequence))
      Ok(Known(target:, epoch:, sequence:))
    }
  }
}

// a frame's sequence or protocol, inside what either target holds exactly
fn wire_int(value: Int) -> Result(Int, Nil) {
  case codec.int_in_range(value) {
    True -> Ok(value)
    False -> Error(Nil)
  }
}

// refuses a lone surrogate, and copies so an id doesn't keep the frame alive
fn wire_string(text: String) -> Result(String, Nil) {
  case codec.is_well_formed(text) {
    True -> Ok(codec.copy_string(text))
    False -> Error(Nil)
  }
}

fn wire_target(target: SyncTarget) -> Result(SyncTarget, Nil) {
  case target {
    Session -> Ok(Session)
    Topic(id:) -> wire_string(id) |> result.map(Topic)
  }
}

